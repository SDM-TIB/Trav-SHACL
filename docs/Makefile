# Makefile for Sphinx documentation

# You can set these variables from the command line.
SPHINXOPTS    =
SPHINXBUILD   = sphinx-build
PAPER         =

# Internal variables.
PAPEROPT_a4     = -D latex_paper_size=a4
PAPEROPT_letter = -D latex_paper_size=letter
ALLSPHINXOPTS   = -d build/doctrees $(PAPEROPT_$(PAPER)) $(SPHINXOPTS) .

.PHONY: help clean html multiversion docs deploy

help:
	@echo "Please use \`make <target>' where <target> is one of"
	@echo "  clean        to clear all files generated by Sphinx"
	@echo "  html         to make standalone HTML files (current checkout only)"
	@echo "  multiversion to build the docs of all released minor versions plus master"
	@echo "  docs         to make multi-version HTML files, removing all previously generated files"


clean:
	rm -rf build
	rm -rf examples modules

html:
	$(SPHINXBUILD) -b html $(ALLSPHINXOPTS) build/html
	@echo
	@echo "Build finished. The HTML pages are in build/html."

multiversion:
	sphinx-multiversion $(SPHINXOPTS) -D html_context.release_order=$$(python3 -c 'import conf; print(conf.RELEASE_ORDER)') . build/html
	python3 build_root.py

docs: clean multiversion

deploy:
	./deploy.sh
	@echo
	@echo "New version of the docs deployed."
